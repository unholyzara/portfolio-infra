digraph architecture {
rankdir=LR;
bgcolor="transparent";
graph [fontname="Helvetica-Bold", penwidth=3];
node [shape=box, style=filled, penwidth=3, fontname="Helvetica-Bold"];
edge [penwidth=2];
"browser" [label="Browser", class="platform"];
"browser" -> "nginx";
subgraph cluster_ec2 {
label="EC2 spot · Docker Compose";
"nginx" [label="nginx\nreverse proxy", class="platform"];
"frontend" [label="frontend\nAngular", class="frontend"];
"admin" [label="admin\nReact", class="frontend"];
"api" [label="api\nDjango + DRF", class="backend"];
"postgres" [label="postgres\nPostgreSQL 16", class="database"];
"backup" [style="filled,dashed", label="backup\nBackup su S3\nprofile: backup", class="job optional"];
"grafana" [style="filled,dashed", label="grafana\nGrafana\nprofile: monitoring", class="monitoring optional"];
}
subgraph cluster_edge {
label="DNS";
"route53" [label="Route 53", class="cloud"];
}
subgraph cluster_config {
label="Config e registry";
"ecr" [label="ECR", class="cloud"];
"ssm" [label="SSM Parameter Store", class="cloud"];
}
subgraph cluster_data {
label="Storage";
"s3_backup" [label="S3 backup", class="cloud"];
}
subgraph cluster_ops {
label="Monitoring";
"cloudwatch" [label="CloudWatch", class="cloud"];
}
"nginx" -> "frontend" [label="unholyzara.dev"];
"nginx" -> "admin" [label="admin.unholyzara.dev"];
"nginx" -> "api" [label="unholyzara.dev/api\nadmin.unholyzara.dev/api"];
"api" -> "postgres";
"backup" -> "postgres";
"nginx" -> "grafana" [label="grafana.unholyzara.dev"];
"route53" -> "nginx" [label="DNS"];
"ecr" -> "frontend" [label="image pull"];
"ecr" -> "admin" [label="image pull"];
"ecr" -> "api" [label="image pull"];
"ssm" -> "api" [label="secrets al boot"];
"backup" -> "s3_backup" [label="dump"];
"grafana" -> "cloudwatch" [label="metriche"];
}
